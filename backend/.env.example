# Backend Environment Variables (Production)
PORT=3003

NODE_ENV=production

# MySQL Database URL (Sesuaikan dengan Database yang dibuat di CloudPanel)
# Format: mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME
DATABASE_URL="mysql://crm_user:password_super_aman_123@127.0.0.1:3306/crm_clients"

# JWT Secret (Ganti dengan string acak dan aman)
JWT_SECRET="ganti_dengan_jwt_secret_acak_dan_aman_12345"

# (Opsional) Konfigurasi SMTP Nodemailer (Fallback jika Kirisan API tidak aktif)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
